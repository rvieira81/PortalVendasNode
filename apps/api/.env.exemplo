# Copie para .env (desenvolvimento). Em produção use variáveis de ambiente/segredos do orquestrador.
NODE_ENV=development
PORTA=3000
DATABASE_URL=postgres://portal:portal@localhost:5433/portalvendas
URL_SITE=http://localhost:5173
NOME_LOJA=Portal de Vendas

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSAO_SEGREDO=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHAVE_CIFRAGEM=

IMAGENS_DIR=./dados/imagens
MIGRACOES_DIR=../../db
EMAIL_PASTA=./emails-dev
LOG_NIVEL=info

# Mercado Pago (credenciais de TESTE no desenvolvimento)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_SEGREDO_WEBHOOK=
MP_URL_NOTIFICACAO=

# Melhor Envio (sandbox no desenvolvimento). Sem token, usa a tabela de contingência.
ME_TOKEN=
ME_URL_API=https://sandbox.melhorenvio.com.br
ME_EMAIL_CONTATO=contato@sualoja.com.br
ME_SERVICOS=

# SMTP (produção). Com EMAIL_PASTA preenchido os e-mails viram arquivos .eml.
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=Portal de Vendas <nao-responda@sualoja.com.br>
