{
  "name": "@portal/api",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --selectProjects unit",
    "db:migrar": "ts-node --transpile-only src/db/migrar.cli.ts",
    "criar-admin": "ts-node --transpile-only src/admin/criar-admin.cli.ts",
    "dev:debug": "nest start --debug --watch"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/throttler": "6.7.1",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.4",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "nodemailer": "10.2.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "12.0.9",
    "@nestjs/testing": "12.2.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "pino-pretty": "13.2.0",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  }
}
