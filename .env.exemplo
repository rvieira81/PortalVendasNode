# Usado pelo docker compose (copie para .env na raiz). Nunca versione o .env.
# Banco
POSTGRES_DB=portalvendas
POSTGRES_USER=portal
POSTGRES_PASSWORD=troque-esta-senha

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSAO_SEGREDO=
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHAVE_CIFRAGEM=

URL_SITE=http://localhost:8080
NOME_LOJA=Portal de Vendas

# Mercado Pago (TEST- em homologação, APP_USR- em produção)
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_SEGREDO_WEBHOOK=
MP_URL_NOTIFICACAO=

# Melhor Envio (sem token = tabela de contingência)
ME_TOKEN=
ME_URL_API=https://sandbox.melhorenvio.com.br
ME_EMAIL_CONTATO=contato@sualoja.com.br

# SMTP (vazio = e-mails gravados em /dados/emails dentro do contêiner da API, só para testes)
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=Portal de Vendas <nao-responda@sualoja.com.br>

# Produção (docker-compose.prod.yml)
DOMINIO=www.sualoja.com.br
EMAIL_TLS=ti@sualoja.com.br
IMAGEM_API=ghcr.io/SEU-USUARIO/portalvendas-api
IMAGEM_WEB=ghcr.io/SEU-USUARIO/portalvendas-web
VERSAO=latest
